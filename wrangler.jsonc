// Cloudflare Worker settings. One Worker serves the app (static files)
// and the small /api. The name must match the Worker name in the
// Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couple-money",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Live address: couple-money.<your-subdomain>.workers.dev
  "workers_dev": true,
  // Each pull request gets its own preview link.
  "preview_urls": true,
  "assets": {
    // Any page address that is not a file (like /pockets) gets index.html,
    // so the React app can show the right screen.
    "not_found_handling": "single-page-application",
    // Requests to /api/... go to the Worker code first.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // The database (SPEC.md, "Data model"). schema.sql creates its tables:
  // run it in the D1 Console. The ID is not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "couple-money-db",
      "database_id": "42460db2-62c2-4f1e-b4af-bcb7768ce7f6"
    }
  ],
  // Preview links (one per pull request, made by `npx wrangler preview`) use
  // their own test database with the same tables, so testing never touches
  // real data. Run schema.sql in its D1 Console too.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "couple-money-preview-db",
        "database_id": "89be7735-90ff-492a-8a31-2e40666e272b"
      }
    ]
  }
}
